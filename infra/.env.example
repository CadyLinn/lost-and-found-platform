# Copy this file to .env and change the values:  cp .env.example .env
# .env is git-ignored. Never commit real passwords.

POSTGRES_DB=lostfound
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=change-me

# Signs login tokens. At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Only for the Grafana admin login (the dashboard itself is viewable without logging in).
GRAFANA_ADMIN_PASSWORD=change-me

# Set to true when the site is served over HTTPS.
REFRESH_COOKIE_SECURE=false
