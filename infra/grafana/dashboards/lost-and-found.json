{
  "uid": "lost-and-found",
  "title": "Lost & Found",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["lost-and-found"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requests / second",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "p95 latency (all API calls)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.3 } ] } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))" }]
    },
    {
      "id": 3, "type": "stat", "title": "Server errors (5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] } } },
      "targets": [{ "refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\",uri!~\"/actuator.*\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }]
    },
    {
      "id": 4, "type": "stat", "title": "Cache hit ratio",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(cache_gets_total{result=\"hit\"}[5m])) / sum(rate(cache_gets_total{result=~\"hit|miss\"}[5m]))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests / second by endpoint",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "legendFormat": "{{method}} {{uri}}",
        "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "p95 latency by endpoint",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "legendFormat": "{{method}} {{uri}}",
        "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[1m])))" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Responses by status",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "legendFormat": "{{status}}",
        "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Cache hit ratio by cache",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "refId": "A", "legendFormat": "{{cache}}",
        "expr": "sum by (cache) (rate(cache_gets_total{result=\"hit\"}[1m])) / sum by (cache) (rate(cache_gets_total{result=~\"hit|miss\"}[1m]))" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Database connection pool",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "active", "expr": "sum(hikaricp_connections_active)" },
        { "refId": "B", "legendFormat": "waiting for a connection", "expr": "sum(hikaricp_connections_pending)" },
        { "refId": "C", "legendFormat": "max", "expr": "sum(hikaricp_connections_max)" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "legendFormat": "used", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})" },
        { "refId": "B", "legendFormat": "max", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Activity (per minute)",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "posts {{type}}", "expr": "sum by (type) (rate(lostfound_items_created_total[1m])) * 60" },
        { "refId": "B", "legendFormat": "claims {{event}}", "expr": "sum by (event) (rate(lostfound_claims_total[1m])) * 60" },
        { "refId": "C", "legendFormat": "match notifications", "expr": "sum(rate(lostfound_matches_notified_total[1m])) * 60" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Rate-limited requests (per minute)",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{reason}} {{path}}",
        "expr": "sum by (reason, path) (rate(lostfound_ratelimit_rejected_total[1m])) * 60" }]
    }
  ]
}
